DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4300
CLIENT_ORIGIN="http://localhost:5176"
# Set to a cron expression (e.g. "0 */3 * * *") in the deployed demo to auto-reset
# seed data every 3 hours. Leave unset for local dev so your data (and any test
# events you send in) persists.
DEMO_RESEED_CRON=
