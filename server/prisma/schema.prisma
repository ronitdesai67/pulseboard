generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev working; the rhel target is what Vercel's
  // serverless runtime (Amazon Linux 2023) actually loads at cold start.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  projects     Project[]
  createdAt    DateTime  @default(now())
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  apiKey    String   @unique
  events    Event[]
  createdAt DateTime @default(now())
}

model Event {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  name       String
  distinctId String
  // JSON-encoded object, capped at 4KB serialized (see src/constants.js) and
  // validated app-side: keeping it a plain string means the size cap and shape
  // check stay in one place in application code, on the one endpoint that
  // accepts unauthenticated writes.
  properties String   @default("{}")
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([projectId, occurredAt])
  @@index([projectId, name])
  @@index([projectId, distinctId])
}
